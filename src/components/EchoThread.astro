---
// EchoThread comment widget -- see https://echothread.io/docs/guides/astro
// Plain <script> tag, no client directive needed: Astro renders the HTML at
// build time and the widget self-initializes in the browser. Wired into
// recipe pages (src/pages/recipes/[slug].astro, pageId = bare collection id)
// and, as of Aug 16, 2026, blog posts (src/pages/blog/[slug].astro, pageId
// namespaced "blog/<id>" so a post and a recipe sharing a slug can never
// share a thread). Extend to Sami stories the same way if ever wanted --
// just pass a stable, namespaced pageId so comments survive URL changes.
interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}
const { pageId, pageTitle, pageUrl } = Astro.props;
---
<section class="block" id="comments">
  <h2>Notes &amp; Comments</h2>
  <div
    id="echothread"
    data-shortname="brucesbreads"
    data-api-key="aFOvvte2nkPp4GnUyZBVsMuZD8GV9M2y2i1R3AZSc3I"
    data-page-url={pageUrl}
    data-identifier={pageId}
    data-page-title={pageTitle}
    data-theme="--color-bg"
    data-accent-color="var(--tomato)"
  ></div>
  <script src="https://cdn.echothread.io/widget.js"></script>
</section>
