L 509.53,581.65 L 504.04,579.73 L 498.13,581.24 L 490.96,579.43 L 477.03,577.51 L 474.08,574.98 L 466.48,572.15 L 459.31,571.85 L 456.35,568.52 L 450.02,567.81 L 446.22,573.77 L 441.16,572.96 L 442.85,575.39 L 439.47,577.00 L 439.89,581.95 L 438.21,588.01 L 443.27,597.20 L 442.00,609.22 L 439.47,613.97 L 439.47,621.54 L 423.86,622.86 L 419.22,615.18 L 420.48,608.01 L 417.53,605.38 L 416.68,599.63 L 418.79,598.21 L 361.82,594.78 L 274.89,589.63 L 164.75,583.97 L 107.35,581.45 L 101.45,576.60 L 98.91,569.02 L 98.07,560.64 L 93.43,555.39 L 90.90,547.41 L 90.05,541.25 L 87.10,534.78 L 78.66,525.59 L 79.92,520.14 L 77.81,514.99 L 80.77,512.87 L 80.35,504.89 L 83.72,496.81 L 82.88,492.46 L 85.83,486.71 L 84.57,474.59 L 76.55,465.80 L 77.39,461.36 L 74.86,448.83 L 76.13,444.29 L 82.03,437.01 L 84.99,428.33 L 85.83,419.64 L 84.57,413.98 L 90.05,408.73 L 95.96,406.61 L 95.12,404.19 L 99.76,404.19 L 103.98,398.94 L 98.91,394.90 L 91.32,392.07 L 95.54,380.25 L 91.74,376.61 L 90.47,368.33 L 83.30,361.36 L 79.08,354.09 L 76.97,339.04 L 71.48,334.50 L 73.17,330.86 L 69.37,327.63 L 55.45,255.61 L 49.12,224.20 L 43.63,194.51 L 36.04,156.23 L 26.33,111.48 L 20.00,79.06 Z" />

          <!-- Mammoth Cave is in Kentucky -- Sami's first stop beyond this
               map's borders, so it gets a dashed arrow pointing off the
               top-left edge instead of an in-state dot. If out-of-state
               stops keep accumulating, a wider Southeast map is the real
               fix; one charming arrow is fine for now. -->
          <a href="/sami/mammoth-cave/" class="pin-link">
            <line x1="150" y1="58" x2="100" y2="24" stroke="#d9503f" stroke-width="3" stroke-dasharray="6 5" stroke-linecap="round" />
            <path d="M 96,20 L 112,24 L 100,36 Z" fill="#d9503f" />
            <circle class="pin-dot" fill="#d9503f" stroke="#ffffff" stroke-width="2.5" cx="150" cy="58" r="9" />
            <text class="pin-label" fill="#5c4a37" font-family="'Trebuchet MS','Segoe UI',sans-serif" font-size="16" font-weight="700" x="164" y="63" text-anchor="start">Mammoth Cave, KY (off the map!)</text>
          </a>

          <a href="/sami/tallulah-gorge/" class="pin-link">
            <circle class="pin-dot" fill="#d9503f" stroke="#ffffff" stroke-width="2.5" cx="280.75" cy="108.25" r="9" />
            <text class="pin-label" fill="#5c4a37" font-family="'Trebuchet MS','Segoe UI',sans-serif" font-size="16" font-weight="700" x="280.75" y="136" text-anchor="middle">Tallulah Gorge</text>
          </a>

          <a href="/sami/saturday-farmers-market/" class="pin-link">
            <circle class="pin-dot" fill="#d9503f" stroke="#ffffff" stroke-width="2.5" cx="99.25" cy="151.64" r="9" />
            <text class="pin-label" fill="#5c4a37" font-family="'Trebuchet MS','Segoe UI',sans-serif" font-size="16" font-weight="700" x="114" y="157" text-anchor="start">Farmers Market</text>
          </a>

          <a href="/sami/driftwood-beach/" class="pin-link">
            <circle class="pin-dot" fill="#d9503f" stroke="#ffffff" stroke-width="2.5" cx="512.43" cy="537.51" r="9" />
            <text class="pin-label" fill="#5c4a37" font-family="'Trebuchet MS','Segoe UI',sans-serif" font-size="16" font-weight="700" x="497" y="522" text-anchor="end">Driftwood Beach</text>
          </a>
        </svg>
      </div>
    </div>

    <div class="stops">
      <div class="stop-card">
        <div class="pin">🏖️</div>
        <h3>Driftwood Beach</h3>
        <p>Jekyll Island, GA — bleached driftwood, gulls overhead, a golden-hour ending on a sun-warmed log.</p>
        <a href="/sami/driftwood-beach/" class="recipe-link">Read the adventure &rarr;</a>
      </div>
      <div class="stop-card">
        <div class="pin">🏞️</div>
        <h3>Tallulah Gorge</h3>
        <p>Tallulah Falls, GA — a thousand-foot canyon, three waterfalls, and a suspension bridge with a view.</p>
        <a href="/sami/tallulah-gorge/" class="recipe-link">Read the adventure &rarr;</a>
      </div>
      <div class="stop-card">
        <div class="pin">🐐</div>
        <h3>Saturday Farmers Market</h3>
        <p>North Georgia — a fiddle player, a tote-bag tumble, and one very opinionated goat.</p>
        <a href="/sami/saturday-farmers-market/" class="recipe-link">Read the adventure &rarr;</a>
      </div>
      <div class="stop-card">
        <div class="pin">🦇</div>
        <h3>Mammoth Cave</h3>
        <p>Mammoth Cave NP, KY — 426 miles of cave, thirteen kinds of bats, and not one of them available for the Giants.</p>
        <a href="/sami/mammoth-cave/" class="recipe-link">Read the adventure &rarr;</a>
      </div>
    </div>

    <p class="more-soon">More of Sami's adventures are on the way — check back for new pins.</p>

  </main>
</SamiLayout>
